 "captions": [
  {
   "id": "c01",
   "text": "66 MILLION YEARS AGO",
   "t0": 0.9,
   "t1": 5.0,
   "style": "cap"
  },
  {
   "id": "c02",
   "text": "3 OF EVERY 4 SPECIES DIED \u2014 IN ONE DAY",
   "t0": 5.3,
   "t1": 11.53,
   "style": "cap"
  },
  {
   "id": "c03",
   "text": "A METAL FROM SPACE \u2014 ON EVERY CONTINENT",
   "t0": 16.86,
   "t1": 26.16,
   "style": "cap"
  },
  {
   "id": "c04",
   "text": "WHAT IF A GIANT ASTEROID HIT EARTH?",
   "t0": 34.94,
   "t1": 41.44,
   "style": "cap"
  },
  {
   "id": "c05",
   "text": "CHICXULUB: THE CRATER UNDER MEXICO",
   "t0": 44.7,
   "t1": 50.7,
   "style": "cap"
  },
  {
   "id": "c06",
   "text": "THE KILLER: 9 MILES ACROSS",
   "t0": 51.0,
   "t1": 55.3,
   "style": "cap"
  },
  {
   "id": "c07",
   "text": "10 BILLION HIROSHIMAS",
   "t0": 55.9,
   "t1": 61.4,
   "style": "cap_big"
  },
  {
   "id": "c08",
   "text": "TANIS: THE FOSSIL GRAVEYARD",
   "t0": 63.7,
   "t1": 69.3,
   "style": "cap"
  },
  {
   "id": "c09",
   "text": "GLASS FROM THE ASTEROID \u2014 IN THEIR GILLS",
   "t0": 71.5,
   "t1": 77.3,
   "style": "cap"
  },
  {
   "id": "c10",
   "text": "THE DAY THE DINOSAURS DIED. CAUGHT IN THE ACT.",
   "t0": 78.7,
   "t1": 82.2,
   "style": "cap"
  },
  {
   "id": "c11",
   "text": "A MEGATSUNAMI \u2014 TALLER THAN SKYSCRAPERS",
   "t0": 84.12,
   "t1": 90.02,
   "style": "cap"
  },
  {
   "id": "c12",
   "text": "FIRESTORMS CIRCLED THE PLANET",
   "t0": 92.12,
   "t1": 98.02,
   "style": "cap"
  },
  {
   "id": "c13",
   "text": "DARKNESS. FOR YEARS.",
   "t0": 100.12,
   "t1": 105.42,
   "style": "cap_big"
  },
  {
   "id": "c14",
   "text": "75% OF ALL SPECIES \u2014 GONE",
   "t0": 107.18,
   "t1": 110.78,
   "style": "cap_big"
  },
  {
   "id": "c15",
   "text": "BUT SOME SURVIVED",
   "t0": 111.28,
   "t1": 116.18,
   "style": "cap"
  },
  {
   "id": "c16",
   "text": "YOU'RE LOOKING AT THEIR DESCENDANTS",
   "t0": 116.98,
   "t1": 129.31,
   "style": "cap"
  }
 ]
